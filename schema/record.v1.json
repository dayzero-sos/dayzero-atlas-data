{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://dayzero.example/schema/record.v1.json",
 "title": "DayZero requirement record v1.1",
 "type": "object",
 "required": [
  "id",
  "alias",
  "source",
  "wording",
  "wordingSHA256",
  "actor",
  "verificationIntent",
  "kind",
  "binding",
  "status"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^DZR-F\\d+-\\d{4}$"
  },
  "alias": {
   "type": "string"
  },
  "source": {
   "type": "object",
   "required": [
    "docId",
    "edition",
    "paragraph",
    "url",
    "passage",
    "passageSHA256"
   ],
   "properties": {
    "docId": {
     "type": "string"
    },
    "edition": {
     "type": "string"
    },
    "paragraph": {
     "type": "string"
    },
    "url": {
     "type": "string"
    },
    "passage": {
     "type": "string"
    },
    "passageSHA256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    }
   }
  },
  "wording": {
   "type": "string"
  },
  "wordingSHA256": {
   "type": "string",
   "pattern": "^[0-9a-f]{64}$"
  },
  "actor": {
   "type": "string"
  },
  "condition": {
   "type": "string"
  },
  "verificationIntent": {
   "enum": [
    "inspection",
    "analysis",
    "demonstration",
    "test"
   ]
  },
  "kind": {
   "type": "string"
  },
  "binding": {
   "type": "boolean"
  },
  "fields": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "status": {
   "enum": [
    "sample",
    "reviewed",
    "adopted",
    "unsourced"
   ]
  },
  "notes": {
   "type": "string"
  },
  "party": {
   "type": "string",
   "enum": [
    "acquirer",
    "prime",
    "supplier",
    "shared-interface"
   ],
   "description": "Who the record belongs to when it is a program record; absent on public records."
  },
  "rights": {
   "type": "string",
   "enum": [
    "unlimited",
    "government-purpose",
    "limited",
    "restricted",
    "sbir",
    "proprietary"
   ],
   "description": "The data-rights category asserted for the record or deliverable (DFARS 252.227-7013/7014 categories, plus proprietary for commercial items); absent on public-domain records."
  },
  "tailoring": {
   "type": "object",
   "description": "Why it applies here: the tailoring decision for a program.",
   "properties": {
    "decision": {
     "type": "string",
     "enum": [
      "applies",
      "tailored",
      "waiver",
      "not-applicable",
      "needs-review"
     ]
    },
    "rationale": {
     "type": "string"
    },
    "authority": {
     "type": "string"
    },
    "dueOffset": {
     "type": "string"
    },
    "decidedBy": {
     "type": "string"
    },
    "date": {
     "type": "string"
    }
   },
   "required": [
    "decision"
   ]
  },
  "prov": {
   "type": "object",
   "description": "Provenance of the record itself: who made it, when, by what step, from what.",
   "properties": {
    "who": {
     "type": "string"
    },
    "when": {
     "type": "string"
    },
    "how": {
     "type": "string"
    },
    "from": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  }
 },
 "description": "A requirement record. v1.1 (2026-11-08) adds optional fields: party, rights, tailoring, prov. Additive: every v1 record is a valid v1.1 record; the manifest rows are unchanged (id, wordingSHA256, source.docId, source.paragraph, source.passageSHA256), so a release hashes the same under both."
}
